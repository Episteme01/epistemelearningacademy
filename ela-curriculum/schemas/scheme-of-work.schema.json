{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://episteme01.github.io/ela-curriculum/scheme-of-work.schema.json",
  "title": "ELA preschool weekly plan (one week of a term scheme, with its five lessons)",
  "type": "object",
  "required": ["id", "class", "subject", "term", "week", "title", "topic", "subtopics", "weekType", "objectives", "vocabulary", "content", "teachingActivities", "learnerActivities", "resources", "assessment", "expectedOutcomes", "crossCurricular", "references", "version", "status", "lessons"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ELA-PS-(TOD|N1|N2|REC)-(NUM|LIT|SCI|SOC)-T[1-3]-W(0[1-9]|10)$" },
    "class": { "enum": ["Toddler", "Nursery 1", "Nursery 2", "Reception"] },
    "subject": { "enum": ["Numeracy", "Literacy", "Science", "Social Habits"] },
    "term": { "type": "integer", "minimum": 1, "maximum": 3 },
    "week": { "type": "integer", "minimum": 1, "maximum": 10 },
    "title": { "type": "string", "minLength": 5 },
    "topic": { "type": "string", "minLength": 3 },
    "subtopics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "weekType": { "enum": ["new-learning", "consolidation", "revision-assessment"] },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "vocabulary": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "content": { "type": "string", "minLength": 20 },
    "teachingActivities": { "type": "string", "minLength": 20 },
    "learnerActivities": { "type": "string", "minLength": 20 },
    "resources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "assessment": { "type": "string", "minLength": 15 },
    "expectedOutcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "crossCurricular": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "references": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" } },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "review", "approved", "published", "archived"] },
    "lessons": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "lesson.schema.json" } }
  }
}
