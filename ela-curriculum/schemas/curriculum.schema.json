{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://episteme01.github.io/ela-curriculum/curriculum.schema.json",
  "title": "ELA preschool class-subject programme (framework and scope and sequence)",
  "type": "object",
  "required": ["id", "title", "class", "subject", "level", "philosophy", "rationale", "aims", "learningOutcomes", "developmentalExpectations", "keyCompetencies", "strands", "priorKnowledge", "yearProgression", "assessmentPrinciples", "inclusion", "crossCurricular", "parentConnection", "scopeAndSequence", "references", "version", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ELA-PS-(TOD|N1|N2|REC)-(NUM|LIT|SCI|SOC)$" },
    "title": { "type": "string" },
    "class": { "enum": ["Toddler", "Nursery 1", "Nursery 2", "Reception"] },
    "subject": { "enum": ["Numeracy", "Literacy", "Science", "Social Habits"] },
    "level": { "const": "Early Years" },
    "philosophy": { "type": "string", "minLength": 30 },
    "rationale": { "type": "string", "minLength": 30 },
    "aims": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "learningOutcomes": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "developmentalExpectations": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "keyCompetencies": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "strands": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["id", "title", "description"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" } } } },
    "priorKnowledge": { "type": "string" },
    "yearProgression": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 20 } },
    "assessmentPrinciples": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "inclusion": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "crossCurricular": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "parentConnection": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "scopeAndSequence": {
      "type": "array",
      "items": { "type": "object", "required": ["term", "week", "weekId", "topic", "subtopics", "objectives", "vocabulary", "expectedOutcomes"], "additionalProperties": false, "properties": { "term": { "type": "integer" }, "week": { "type": "integer" }, "weekId": { "type": "string" }, "topic": { "type": "string" }, "subtopics": { "type": "array", "items": { "type": "string" } }, "objectives": { "type": "array", "items": { "type": "string" } }, "vocabulary": { "type": "array", "items": { "type": "string" } }, "expectedOutcomes": { "type": "array", "items": { "type": "string" } } } }
    },
    "references": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" } },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "review", "approved", "published", "archived"] }
  }
}
